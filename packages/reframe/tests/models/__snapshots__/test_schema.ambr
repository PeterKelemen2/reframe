# name: test_json_schema_snapshot[CropSettings]
  dict({
    '$defs': list([
      'CropRect',
    ]),
    'description': '''
      Crop mode and the crop rectangle.
      
      - ``auto``: the most common ``cropdetect`` result over the sample frames;
        ``conservative``: only what is black on every sample. In both modes ``rect`` holds the
        detected crop once detection ran (``None`` before: no crop is applied, and validation
        says so).
      - ``none``: no crop (``rect`` is ignored).
      - ``manual``: ``rect`` as the user set it.
    ''',
    'properties': dict({
      'detection_error': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': '''
          Why crop detection failed in this job's file (``auto`` and ``conservative`` without
          ``rect``): the picture is not cropped. ``None``: detection did not fail.
        ''',
        'title': 'Detection Error',
      }),
      'mode': dict({
        'default': 'auto',
        'enum': list([
          'auto',
          'conservative',
          'none',
          'manual',
        ]),
        'title': 'Mode',
        'type': 'string',
      }),
      'rect': dict({
        'anyOf': list([
          dict({
            '$ref': '#/$defs/CropRect',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
      }),
    }),
    'title': 'CropSettings',
    'type': 'object',
  })
# ---
