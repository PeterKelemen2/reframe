          }),
          'propertyName': 'mode',
        }),
        'oneOf': list([
          dict({
            '$ref': '#/$defs/SameAsSource',
          }),
          dict({
            '$ref': '#/$defs/FitWithin',
          }),
          dict({
            '$ref': '#/$defs/ExactWidth',
          }),
