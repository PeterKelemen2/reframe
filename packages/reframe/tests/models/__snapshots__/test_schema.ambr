        'title': 'Path',
        'type': 'string',
      }),
      'preset_value': dict({
        '$ref': '#/$defs/JsonValue',
        'default': None,
        'description': "The preset's value (``None`` for ``added``).",
      }),
      'value': dict({
        '$ref': '#/$defs/JsonValue',
        'default': None,
        'description': 'The edited value (``None`` for ``removed``).',
      }),
    }),
    'required': list([
      'path',
    ]),
    'title': 'FieldChange',
    'type': 'object',
  })
