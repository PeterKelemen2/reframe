        'type': 'string',
      }),
      'name': dict({
        'description': "The manifest's build name (``default``, ``compat``).",
        'title': 'Name',
        'type': 'string',
      }),
      'release_version': dict({
        'description': 'The upstream release the build is based on (``9.0.2``).',
        'title': 'Release Version',
        'type': 'string',
      }),
      'sha256': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': '''
          The SHA-256 of this platform's archive (64 lowercase hex digits), which an install
          checks; ``None`` when the build has none for this platform.
        ''',
        'title': 'Sha256',
      }),
      'size': dict({
        'anyOf': list([
          dict({
            'type': 'integer',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': "Bytes of this platform's archive; ``None`` when the build has none for this platform.",
        'title': 'Size',
      }),
      'source_links': dict({
        'description': 'Where the corresponding source is: the FFmpeg commit and the build scripts.',
        'items': dict({
          'type': 'string',
        }),
        'title': 'Source Links',
        'type': 'array',
      }),
      'summary': dict({
        'description': 'One sentence on who the build is for ("For NVIDIA drivers 570 to 609").',
        'title': 'Summary',
        'type': 'string',
      }),
      'version': dict({
        'description': 'What ``ffmpeg -version`` prints after ``ffmpeg version``.',
        'title': 'Version',
        'type': 'string',
      }),
    }),
    'required': list([
      'name',
      'label',
      'summary',
      'version',
      'release_version',
      'license',
    ]),
    'title': 'ToolBuildOffer',
    'type': 'object',
  })
