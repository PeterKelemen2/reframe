    '$defs': list([
      'AudioCodecRule',
      'AudioRuleExtras',
      'ExtraAudioOutput',
      'PassthruPolicy',
    ]),
    'description': '''
      Codec rules evaluated per matched source track (compiled from the preset's audio
      defaults). The last rule is the catch-all; the model enforces it.
    ''',
    'properties': dict({
      'kind': dict({
        'const': 'audio_rules',
        'default': 'audio_rules',
        'title': 'Kind',
        'type': 'string',
      }),
      'passthru': dict({
        '$ref': '#/$defs/PassthruPolicy',
      }),
      'rules': dict({
        'items': dict({
          '$ref': '#/$defs/AudioCodecRule',
        }),
        'title': 'Rules',
        'type': 'array',
      }),
    }),
    'title': 'AudioCodecRules',
    'type': 'object',
  })
