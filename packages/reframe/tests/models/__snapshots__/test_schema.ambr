        'description': "The manifest's build name (``default``).",
        'title': 'Build',
        'type': 'string',
      }),
      'downloaded': dict({
        'default': True,
        'description': '``False``: the build was already installed and every file still had its hash.',
        'title': 'Downloaded',
        'type': 'boolean',
      }),
      'ffmpeg': dict({
        'format': 'path',
        'title': 'Ffmpeg',
        'type': 'string',
      }),
      'ffprobe': dict({
        'format': 'path',
        'title': 'Ffprobe',
        'type': 'string',
      }),
      'install_dir': dict({
        'description': '``<data dir>/tools/ffmpeg``.',
        'format': 'path',
        'title': 'Install Dir',
        'type': 'string',
      }),
      'platform': dict({
        'description': '``linux-x64`` or ``windows-x64``.',
        'title': 'Platform',
        'type': 'string',
      }),
      'version': dict({
        'description': 'The pinned FFmpeg version string.',
        'title': 'Version',
        'type': 'string',
      }),
    }),
    'required': list([
      'build',
      'platform',
      'version',
      'install_dir',
      'ffmpeg',
      'ffprobe',
    ]),
    'title': 'ToolFetchResult',
    'type': 'object',
  })
