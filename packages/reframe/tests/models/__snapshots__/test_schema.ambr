# name: test_json_schema_snapshot[EncoderStatus]
  dict({
    '$defs': list([
      'EncoderState',
    ]),
    'additionalProperties': False,
    'description': 'The detection result of one encoder.',
    'properties': dict({
      'build_mismatch': dict({
        'default': False,
        'description': '''
          ``True`` when the encoder is unavailable because this FFmpeg build needs newer system
          software than the computer has (an NVIDIA driver older than the build's NVENC needs, a
          system library too old for the build): a driver update or another FFmpeg build can make it
          available. Never set by a 10-bit-only limit.
        ''',
        'title': 'Build Mismatch',
        'type': 'boolean',
      }),
      'build_mismatch_cause': dict({
        'anyOf': list([
          dict({
            'enum': list([
              'driver',
              'system_library',
            ]),
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': '''
          What the build needs when ``build_mismatch`` is ``True``: ``driver``, a newer GPU driver
          (another build can help), or ``system_library``, a system library that is missing or too
          old, such as libva (install or update it, or use an FFmpeg that does not need it). ``None``
          otherwise.
        ''',
        'title': 'Build Mismatch Cause',
      }),
      'checked_at': dict({
        'anyOf': list([
          dict({
            'format': 'date-time',
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'title': 'Checked At',
      }),
      'detail': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': 'The FFmpeg line the reason was derived from (for the log and bug reports).',
        'title': 'Detail',
      }),
      'device': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': '''
          The device the encoder works on, for encoders that need one: the VAAPI render node
          (``/dev/dri/renderD128``), the first node where the test encode worked, or the node that
          Settings → Encoders forces. The command builder uses it. ``None`` for encoders without a
          device choice and for encoders that are not available.
        ''',
        'title': 'Device',
      }),
      'hardware': dict({
        'default': False,
        'title': 'Hardware',
        'type': 'boolean',
      }),
      'id': dict({
        'description': 'Encoder id as FFmpeg names it: ``libx265``, ``hevc_nvenc``.',
        'title': 'Id',
        'type': 'string',
      }),
      'in_build': dict({
        'anyOf': list([
          dict({
            'type': 'boolean',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': 'Listed by ``ffmpeg -encoders``; ``None`` before the list was read.',
        'title': 'In Build',
      }),
      'pix_fmts': dict({
        'description': '''
          Pixel formats the encoder accepts in this build (the ``Supported pixel formats`` line of
          ``ffmpeg -h encoder=<id>``). VAAPI encoders list only ``vaapi``: they take hardware frames.
          Empty when not read.
        ''',
        'items': dict({
          'type': 'string',
        }),
        'title': 'Pix Fmts',
        'type': 'array',
      }),
      'presets': dict({
        'description': 'Speed presets this build offers, if the encoder lists them.',
        'items': dict({
          'type': 'string',
        }),
        'title': 'Presets',
        'type': 'array',
      }),
      'private_options': dict({
        'description': 'Private options this build supports (``ffmpeg -h encoder=<id>``).',
        'items': dict({
          'type': 'string',
        }),
        'title': 'Private Options',
        'type': 'array',
      }),
      'reason': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': 'Plain-language reason for ``unavailable`` / ``error`` ("NVIDIA driver not found").',
        'title': 'Reason',
      }),
      'reason_10bit': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': '''
          Why ``supports_10bit`` is ``False`` when the 10-bit test encode failed ("10-bit is not
          supported by this encoder").
        ''',
        'title': 'Reason 10Bit',
      }),
      'state': dict({
        '$ref': '#/$defs/EncoderState',
        'default': 'unknown',
      }),
      'supports_10bit': dict({
        'anyOf': list([
          dict({
            'type': 'boolean',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': '``None`` = not known (not tested).',
        'title': 'Supports 10Bit',
      }),
    }),
    'required': list([
      'id',
    ]),
    'title': 'EncoderStatus',
    'type': 'object',
  })
