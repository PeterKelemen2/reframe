      'SubtitleDefaults',
      'SubtitleOutputSettings',
      'TagSettings',
      'TrackMetadata',
      'TrackMetadataTemplate',
      'TrackRole',
      'TrackSelection',
      'TrackSelector',
      'VideoSettings',
    ]),
    'description': '''
      ``JobSettings`` without source-specific fields, plus rules, naming and policies.
      
      Not in a template: the source, the range (always the full file), the output path and
      per-job name, concrete audio/subtitle tracks, chapter names.
    ''',
    'properties': dict({
      'audio_defaults': dict({
        '$ref': '#/$defs/AudioDefaults',
      }),
      'audio_rules': dict({
        'items': dict({
          '$ref': '#/$defs/OutputTrackRule',
        }),
        'title': 'Audio Rules',
        'type': 'array',
      }),
      'chapter_name_policy': dict({
        'default': 'source',
        'enum': list([
          'source',
          'generated',
        ]),
        'title': 'Chapter Name Policy',
        'type': 'string',
      }),
      'chapters': dict({
        '$ref': '#/$defs/ChapterOptions',
      }),
      'crop_policy': dict({
        'default': 'detect_per_file',
        'enum': list([
          'detect_per_file',
          'fixed',
        ]),
        'title': 'Crop Policy',
        'type': 'string',
      }),
      'dimensions': dict({
        '$ref': '#/$defs/DimensionSettings',
      }),
      'filters': dict({
        '$ref': '#/$defs/FilterSettings',
      }),
      'naming': dict({
        'anyOf': list([
          dict({
            '$ref': '#/$defs/NamingOptions',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': '``None`` = the naming options from Settings → Output.',
      }),
      'output': dict({
        '$ref': '#/$defs/OutputOptions',
      }),
      'schema_version': dict({
        'default': 1,
        'minimum': 1,
        'title': 'Schema Version',
        'type': 'integer',
      }),
      'subtitle_defaults': dict({
        '$ref': '#/$defs/SubtitleDefaults',
      }),
      'subtitle_rules': dict({
        'items': dict({
          '$ref': '#/$defs/OutputTrackRule',
        }),
        'title': 'Subtitle Rules',
        'type': 'array',
      }),
      'tags': dict({
        '$ref': '#/$defs/TagSettings',
        'description': 'Tag templates (they may use naming variables).',
      }),
      'video': dict({
        '$ref': '#/$defs/VideoSettings',
      }),
    }),
    'title': 'JobTemplate',
    'type': 'object',
  })
