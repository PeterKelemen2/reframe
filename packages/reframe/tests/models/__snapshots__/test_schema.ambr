      'only': dict({
        'anyOf': list([
          dict({
            'items': dict({
              'type': 'string',
            }),
            'type': 'array',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'description': '''
          It takes only these jobs, the ones a ``start`` with ``job_ids`` named (an id may name a
          job that has left the queue since); ``null``: every waiting job, or not processing.
        ''',
        'title': 'Only',
      }),
      'processing': dict({
        'description': 'The runner takes waiting jobs (running and paused jobs go on either way).',
        'title': 'Processing',
        'type': 'boolean',
      }),
      'reason': dict({
        'description': '''
          ``start`` and ``stop``: a front end's call; ``idle``: the jobs that a ``start`` named
          have all ended.
        ''',
        'enum': list([
          'start',
          'stop',
          'idle',
        ]),
        'title': 'Reason',
        'type': 'string',
      }),
      'type': dict({
        'const': 'queue.processing',
        'default': 'queue.processing',
        'title': 'Type',
        'type': 'string',
      }),
    }),
    'required': list([
      'processing',
      'only',
      'reason',
    ]),
    'title': 'QueueProcessingEvent',
    'type': 'object',
  })
