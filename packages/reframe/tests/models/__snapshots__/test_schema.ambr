# name: test_json_schema_snapshot[AudioCodecRule]
  dict({
    '$defs': list([
      'AudioRuleExtras',
      'ExtraAudioOutput',
    ]),
    'description': '''
      One row of the codec-rule table. Rules are checked top to bottom; the first that
      matches a selected track wins.
      
      ``languages`` ``None`` = any language; ``codec`` is an encoder id or ``"passthru"``;
      ``max_bitrate`` is in kb/s (``None`` for lossless encoders such as FLAC) and snaps to the
      encoder's allowed values. A rule with ``languages=None`` and ``source_channels="any"`` is
      a **catch-all**.
    ''',
    'properties': dict({
      'codec': dict({
        'default': 'aac',
        'title': 'Codec',
        'type': 'string',
      }),
      'extras': dict({
        '$ref': '#/$defs/AudioRuleExtras',
      }),
      'if_fits': dict({
        'default': 'passthru',
        'enum': list([
          'passthru',
          'reencode',
        ]),
        'title': 'If Fits',
        'type': 'string',
      }),
      'languages': dict({
        'anyOf': list([
          dict({
            'items': dict({
              'maxLength': 64,
              'pattern': '^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$',
              'type': 'string',
            }),
            'type': 'array',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'title': 'Languages',
      }),
      'max_bitrate': dict({
        'anyOf': list([
          dict({
            'minimum': 1,
            'type': 'integer',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'title': 'Max Bitrate',
      }),
      'mixdown': dict({
        'default': 'keep',
        'enum': list([
          'keep',
          'up_to_5.1',
          '5.1',
          'stereo',
          'dpl2',
          'mono',
        ]),
        'title': 'Mixdown',
        'type': 'string',
      }),
      'source_channels': dict({
        'default': 'any',
        'enum': list([
          'any',
          'mono',
          'stereo_or_less',
          '5.1_or_more',
          '7.1_or_more',
        ]),
        'title': 'Source Channels',
        'type': 'string',
      }),
    }),
    'title': 'AudioCodecRule',
    'type': 'object',
  })
# ---
