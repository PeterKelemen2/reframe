    '$defs': list([
    ]),
    'description': '''
      Identifies one version of a file: a change in size or mtime means "probe again".
      
      ``mtime`` is seconds as a float (not nanoseconds): a JavaScript client keeps a float
      exactly, but not an integer above 2**53.
    ''',
    'properties': dict({
      'mtime': dict({
        'title': 'Mtime',
        'type': 'number',
      }),
      'probe_hash': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': 'A hash of the probe result (stream layout); ``None`` before the file is probed.',
        'title': 'Probe Hash',
      }),
      'size': dict({
        'minimum': 0,
        'title': 'Size',
        'type': 'integer',
      }),
    }),
    'required': list([
      'size',
      'mtime',
    ]),
    'title': 'SourceFingerprint',
    'type': 'object',
  })
