# name: test_json_schema_snapshot[DimensionSettings]
  dict({
    '$defs': list([
      'CropRect',
      'CropSettings',
      'ExactHeight',
      'ExactWidth',
      'FitWithin',
      'Rational',
      'SameAsSource',
    ]),
    'description': '''
      ``JobSettings.dimensions``: rotate, flip, crop, size, pixel aspect, modulus, scaler.
      
      Defaults are those of 03 §Dimensions: fit within 1080p, no upscaling, square pixels,
      modulus 2, Lanczos. ``custom_par`` is used only with ``pixel_aspect="custom"`` (a missing
      value is a validation issue, not a model error).
    ''',
    'properties': dict({
      'allow_upscaling': dict({
        'default': False,
        'title': 'Allow Upscaling',
        'type': 'boolean',
      }),
      'crop': dict({
        '$ref': '#/$defs/CropSettings',
      }),
      'custom_par': dict({
        'anyOf': list([
          dict({
            '$ref': '#/$defs/Rational',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
      }),
      'flip_horizontal': dict({
        'default': False,
        'title': 'Flip Horizontal',
        'type': 'boolean',
      }),
      'modulus': dict({
        'default': 2,
        'enum': list([
          2,
          4,
          8,
          16,
        ]),
        'title': 'Modulus',
        'type': 'integer',
      }),
      'pixel_aspect': dict({
        'default': 'square',
        'enum': list([
          'square',
          'keep',
          'custom',
        ]),
        'title': 'Pixel Aspect',
        'type': 'string',
      }),
      'rotate': dict({
        'default': 0,
        'enum': list([
          0,
          90,
          180,
          270,
        ]),
        'title': 'Rotate',
        'type': 'integer',
      }),
      'scaler': dict({
        'default': 'lanczos',
