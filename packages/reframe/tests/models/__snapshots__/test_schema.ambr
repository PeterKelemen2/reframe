          source file itself, preset options the draft does not apply.
        ''',
        'items': dict({
          'type': 'string',
        }),
        'title': 'Notes',
        'type': 'array',
      }),
      'subtitle_decisions': dict({
        'description': 'One per source subtitle track, in source order.',
