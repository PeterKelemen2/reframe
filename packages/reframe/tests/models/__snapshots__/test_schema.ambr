        'description': 'Run the hardware test encodes. Off: hardware encoders stay "unknown".',
        'title': 'Hardware Tests',
        'type': 'boolean',
      }),
      'vaapi_device': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': '''
          The VAAPI render node to use (``/dev/dri/renderD129``). ``None`` or empty = automatic:
          detection tests the VAAPI encoders on every ``/dev/dri/renderD*`` node and each encoder
          uses the first node where it works.
        ''',
        'title': 'Vaapi Device',
      }),
    }),
    'title': 'EncoderSettings',
    'type': 'object',
  })
