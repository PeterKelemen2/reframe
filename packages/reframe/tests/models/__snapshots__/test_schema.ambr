        'description': 'Absolute stream index in the file (``-map 0:<index>``).',
        'minimum': 0,
        'title': 'Index',
        'type': 'integer',
      }),
      'kind': dict({
        'const': 'audio',
        'default': 'audio',
        'title': 'Kind',
        'type': 'string',
      }),
      'language': dict({
        'anyOf': list([
          dict({
            'maxLength': 64,
            'pattern': '^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$',
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': '''
          The language tag as ffprobe reports it (``eng``, ``hun``; for Matroska the legacy
          ISO 639-2 ``Language`` element); ``None`` if absent.
        ''',
        'title': 'Language',
      }),
      'language_ietf': dict({
        'anyOf': list([
          dict({
            'maxLength': 64,
            'pattern': '^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$',
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': '''
          The BCP 47 tag as MediaInfo reports it (``pt-BR``, ``zh-Hant``): for Matroska the
          ``LanguageIETF`` element, which ffprobe does not show (after ``mkvpropedit --set
          language=pt-BR`` ffprobe says ``por``). ``None`` when MediaInfo is not available.
          
          The **effective language** (what C-12 track rules match) is ``language_ietf`` if set, else
          ``language``.
        ''',
        'title': 'Language Ietf',
      }),
      'lossless': dict({
        'default': False,
        'description': 'TrueHD, DTS-HD MA, FLAC, PCM, ALAC: encoded at the maximum by codec rules (03).',
        'title': 'Lossless',
        'type': 'boolean',
      }),
      'profile': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': 'ffprobe ``profile`` (``Main 10``, ``DTS-HD MA``).',
        'title': 'Profile',
      }),
      'roles': dict({
        'items': dict({
          '$ref': '#/$defs/TrackRoleInfo',
        }),
        'title': 'Roles',
        'type': 'array',
      }),
      'sample_fmt': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'title': 'Sample Fmt',
      }),
      'sample_rate': dict({
        'anyOf': list([
          dict({
            'minimum': 1,
            'type': 'integer',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'title': 'Sample Rate',
      }),
      'start_time': dict({
        'anyOf': list([
          dict({
            'type': 'number',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': "ffprobe's raw ``start_time`` in seconds (the first packet's timestamp).",
        'title': 'Start Time',
      }),
      'tags': dict({
        'additionalProperties': dict({
          'type': 'string',
        }),
        'description': 'All stream tags as ffprobe prints them.',
        'title': 'Tags',
        'type': 'object',
      }),
