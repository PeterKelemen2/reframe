        'enum': list([
          'changed',
          'added',
          'removed',
        ]),
        'title': 'Kind',
        'type': 'string',
      }),
      'path': dict({
        'description': '''
          Dotted field path, as in ``ValidationIssue.path``: ``video.encoder``,
