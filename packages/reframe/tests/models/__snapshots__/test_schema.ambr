# name: test_json_schema_snapshot[Geometry]
  dict({
    '$defs': list([
      'CropRect',
      'Rational',
    ]),
    'additionalProperties': False,
    'description': '''
      The result of C-5's ``compute_geometry``.
      
      ``scaled_width`` x ``scaled_height`` is the stored output size; ``output_sar`` its pixel
      aspect; ``display_aspect`` = width x SAR / height. ``notes`` explain every snap or limit
      ("Crop left 141 → 140 for 4:2:0").
    ''',
    'properties': dict({
      'crop': dict({
        '$ref': '#/$defs/CropRect',
      }),
      'cropped_height': dict({
        'minimum': 1,
        'title': 'Cropped Height',
        'type': 'integer',
      }),
      'cropped_width': dict({
        'minimum': 1,
        'title': 'Cropped Width',
        'type': 'integer',
      }),
      'display_aspect': dict({
        'exclusiveMinimum': 0,
        'title': 'Display Aspect',
        'type': 'number',
      }),
      'filter_rotation': dict({
        'default': 0,
        'description': '''
          Clockwise rotation that the filter graph applies after the crop: the job's ``rotate``.
          FFmpeg's automatic rotation has already applied the source's display matrix before the
          filter graph, so the crop is in that orientation (``reframe.dimensions``).
        ''',
        'enum': list([
          0,
          90,
          180,
          270,
        ]),
        'title': 'Filter Rotation',
        'type': 'integer',
      }),
      'flip_horizontal': dict({
        'default': False,
        'description': 'Mirror the picture left to right, after the rotation.',
        'title': 'Flip Horizontal',
        'type': 'boolean',
      }),
      'notes': dict({
        'items': dict({
          'type': 'string',
        }),
        'title': 'Notes',
        'type': 'array',
      }),
      'output_sar': dict({
        '$ref': '#/$defs/Rational',
      }),
      'rotation': dict({
        'default': 0,
        'description': 'Total rotation applied (source + job).',
        'enum': list([
          0,
          90,
          180,
          270,
        ]),
        'title': 'Rotation',
        'type': 'integer',
      }),
      'scaled_height': dict({
        'minimum': 1,
        'title': 'Scaled Height',
        'type': 'integer',
      }),
      'scaled_width': dict({
        'minimum': 1,
        'title': 'Scaled Width',
        'type': 'integer',
      }),
      'upscaled': dict({
        'default': False,
        'title': 'Upscaled',
        'type': 'boolean',
      }),
    }),
    'required': list([
      'crop',
      'cropped_width',
      'cropped_height',
      'scaled_width',
      'scaled_height',
      'output_sar',
      'display_aspect',
    ]),
    'title': 'Geometry',
    'type': 'object',
  })
