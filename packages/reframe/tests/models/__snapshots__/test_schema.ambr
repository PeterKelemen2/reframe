# name: test_json_schema_snapshot[ToolInfo]
  dict({
    '$defs': list([
      'AddOp',
      'CopyOp',
      'Fix',
      'JsonValue',
      'MoveOp',
      'RemoveOp',
      'ReplaceOp',
      'TestOp',
      'ToolOrigin',
      'ToolStatus',
    ]),
    'additionalProperties': False,
    'description': '''
      The result of discovering one tool.
      
      When ``origin`` is ``env`` or ``settings`` and the status is not ``found``, Reframe does
      **not** fall back to the bundled build: ``reason`` says why, and ``fixes`` offers
      "Use bundled" (a patch on ``AppSettings`` that removes the Settings path). An environment
      override cannot be changed in the app, so it has no fix, and the reason says so.
    ''',
    'properties': dict({
      'build_flags': dict({
        'description': '''
          FFmpeg: the arguments of the ``configuration:`` line (``--enable-libx265`` …), for
          diagnostics.
        ''',
        'items': dict({
          'type': 'string',
        }),
        'title': 'Build Flags',
        'type': 'array',
      }),
      'bundled': dict({
        'default': False,
        'description': '''
          A bundled build of the tool's family (FFmpeg: ffmpeg and ffprobe) exists, so without a
          Settings path discovery uses it. Also set while an override is in use.
        ''',
        'title': 'Bundled',
        'type': 'boolean',
      }),
      'env': dict({
        'additionalProperties': dict({
          'type': 'string',
        }),
        'description': '''
          Extra environment variables to set when running this tool (for example
          ``LIBVA_DRIVERS_PATH`` for the bundled FFmpeg on Linux).
        ''',
        'title': 'Env',
        'type': 'object',
      }),
      'env_var': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': 'The environment variable that overrides this tool (``REFRAME_FFMPEG``).',
        'title': 'Env Var',
      }),
      'fixes': dict({
        'items': dict({
          '$ref': '#/$defs/Fix',
        }),
        'title': 'Fixes',
        'type': 'array',
      }),
      'library_versions': dict({
        'additionalProperties': dict({
          'type': 'string',
        }),
        'description': 'FFmpeg: the version of each library, by name.',
        'title': 'Library Versions',
        'type': 'object',
      }),
      'name': dict({
        'enum': list([
          'ffmpeg',
          'ffprobe',
        ]),
        'title': 'Name',
        'type': 'string',
      }),
      'next_to_ffmpeg': dict({
        'default': False,
        'description': "ffprobe only: it was found next to an overridden ffmpeg (its ``origin`` is the ffmpeg's).",
        'title': 'Next To Ffmpeg',
        'type': 'boolean',
      }),
      'origin': dict({
        'anyOf': list([
          dict({
            '$ref': '#/$defs/ToolOrigin',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': '``None`` when nothing was found.',
      }),
      'path': dict({
        'anyOf': list([
          dict({
            'format': 'path',
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': 'The binary that is (or would be) run. Set for a missing override too (the bad path).',
        'title': 'Path',
      }),
      'reason': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': '''
          Why the status is not ``found``; for ``found`` an optional note (for example "version
          could not be read").
        ''',
        'title': 'Reason',
      }),
      'release': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': 'The upstream release; ``None`` for git master builds.',
        'title': 'Release',
      }),
      'release_series': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': '''
          The release series of a release. For a git master build, the series of its library
          versions, which the minimum-version check uses.
        ''',
        'title': 'Release Series',
      }),
      'status': dict({
        '$ref': '#/$defs/ToolStatus',
      }),
      'version': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': 'The version string as the tool prints it.',
        'title': 'Version',
      }),
    }),
    'required': list([
      'name',
      'status',
    ]),
    'title': 'ToolInfo',
    'type': 'object',
  })
