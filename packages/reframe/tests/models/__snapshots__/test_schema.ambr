        'type': 'string',
      }),
      'default_track': dict({
        'default': 'first_output',
        'description': '``forced`` is meant for subtitles.',
        'enum': list([
          'first_output',
          'first_in_first_language',
          'forced',
          'none',
        ]),
        'title': 'Default Track',
        'type': 'string',
      }),
      'languages': dict({
        'anyOf': list([
          dict({
            'items': dict({
              'maxLength': 64,
              'pattern': '^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$',
              'type': 'string',
            }),
            'type': 'array',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'title': 'Languages',
      }),
      'no_match': dict({
        'default': 'default_flagged',
        'description': 'No listed language found. ``none`` = take none (a validation error for audio).',
