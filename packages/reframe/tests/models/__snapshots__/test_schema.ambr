          }),
        ]),
        'default': None,
        'title': 'Custom',
      }),
      'implementation': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': '''
          The FFmpeg implementation of the filter, by its id in the definitions. ``None`` = the
          filter's default: the first implementation the FFmpeg build can run.
        ''',
        'title': 'Implementation',
      }),
      'preset': dict({
        'default': 'default',
        'description': 'A preset of the chosen implementation.',
        'title': 'Preset',
        'type': 'string',
      }),
      'tune': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'title': 'Tune',
      }),
    }),
    'title': 'FilterConfig',
    'type': 'object',
  })
