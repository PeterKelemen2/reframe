# name: test_json_schema_snapshot[CapabilitySnapshot]
  dict({
    '$defs': list([
      'EncoderState',
      'EncoderStatus',
    ]),
    'additionalProperties': False,
    'description': '''
      Every known encoder's status at one moment, plus the filters of the build.
      
      The capability service returns one at once (from the cache, or all ``unknown``) and never
      blocks. A finished detection replaces it and publishes ``capabilities.changed``.
    ''',
    'properties': dict({
      'checked_at': dict({
        'anyOf': list([
          dict({
            'format': 'date-time',
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': 'When the last full detection ended.',
        'title': 'Checked At',
      }),
      'detecting': dict({
        'default': False,
        'description': 'A detection is running; statuses may still change.',
        'title': 'Detecting',
        'type': 'boolean',
      }),
      'encoders': dict({
        'additionalProperties': dict({
          '$ref': '#/$defs/EncoderStatus',
        }),
        'description': 'By encoder id: every video and audio encoder of the definitions.',
        'title': 'Encoders',
        'type': 'object',
      }),
      'ffmpeg': dict({
        'anyOf': list([
          dict({
            'format': 'path',
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': 'The ffmpeg binary these results belong to.',
        'title': 'Ffmpeg',
      }),
      'ffmpeg_version': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'title': 'Ffmpeg Version',
      }),
      'filter_failures': dict({
        'additionalProperties': dict({
          'type': 'string',
        }),
        'description': '''
          Filters of the build whose run test failed, with the reason. ``libplacebo`` is listed
          by ``ffmpeg -filters`` but needs a working Vulkan device, so detection runs one frame
          through it.
        ''',
        'title': 'Filter Failures',
        'type': 'object',
      }),
      'filters': dict({
        'anyOf': list([
          dict({
            'items': dict({
              'type': 'string',
            }),
            'type': 'array',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': '''
          Filters in this FFmpeg build (``ffmpeg -filters``: ``libplacebo``, ``zscale``, …);
          ``None`` until the list was read.
        ''',
        'title': 'Filters',
      }),
      'from_cache': dict({
        'default': False,
        'description': 'The statuses come from the cache and have not been checked again yet.',
        'title': 'From Cache',
        'type': 'boolean',
      }),
      'untested_filters': dict({
        'description': '''
          Filters of the build that need a run test that has not passed or failed: while the
          detection runs, or when hardware tests are off (Settings → Encoders).
        ''',
        'items': dict({
          'type': 'string',
        }),
        'title': 'Untested Filters',
        'type': 'array',
      }),
    }),
    'title': 'CapabilitySnapshot',
    'type': 'object',
  })
