# name: test_json_schema_snapshot[ExternalSubtitle]
  dict({
    '$defs': list([
      'TrackFlags',
    ]),
    'description': '''
      An external subtitle file (``.srt``, ``.ass``, ``.ssa``, ``.vtt``, ``.sup``).
      
      ``language``, ``name`` and ``flags`` describe the file as a source track (what the user
      says it is); the output track's ``metadata`` decides what is written.
    ''',
    'properties': dict({
      'charset': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': 'Character encoding (``-sub_charenc``); ``None`` = auto-detected.',
        'title': 'Charset',
      }),
      'flags': dict({
        '$ref': '#/$defs/TrackFlags',
      }),
      'language': dict({
        'anyOf': list([
          dict({
            'maxLength': 64,
            'pattern': '^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$',
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'title': 'Language',
      }),
      'name': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'title': 'Name',
      }),
      'offset_ms': dict({
        'default': 0,
        'description': 'Time offset (``-itsoffset``), milliseconds; may be negative.',
        'title': 'Offset Ms',
        'type': 'integer',
      }),
      'path': dict({
        'format': 'path',
        'title': 'Path',
        'type': 'string',
      }),
    }),
    'required': list([
      'path',
    ]),
    'title': 'ExternalSubtitle',
    'type': 'object',
  })
