# name: test_json_schema_snapshot[JobNaming]
  dict({
    '$defs': list([
    ]),
    'description': '''
      Per-job output naming: the template from the preset/Settings, or a manual name.
      
      ``mode="manual"`` uses ``manual_name`` (*Reset to template* sets ``mode`` back).
      ``template`` and ``name_source`` override the preset's naming options for this job only
      (``None`` = use them). ``field_overrides`` holds the parsed-name fields that the user
      corrected for this file.
    ''',
    'properties': dict({
      'field_overrides': dict({
        'additionalProperties': dict({
          'type': 'string',
        }),
        'description': '''
          Parsed-name fields corrected for this file, by variable name (such as ``season``).
          They replace what the parser found; ``""`` clears a field. Numbers are written as text
          (``"3"``). Unknown names and bad numbers are naming issues, not load errors.
        ''',
        'title': 'Field Overrides',
        'type': 'object',
      }),
      'manual_name': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': 'File name without folder; the extension comes from the container.',
        'title': 'Manual Name',
      }),
      'mode': dict({
        'default': 'template',
        'enum': list([
          'template',
          'manual',
        ]),
        'title': 'Mode',
        'type': 'string',
      }),
      'name_source': dict({
        'anyOf': list([
          dict({
            'enum': list([
              'auto',
              'file',
              'folder',
            ]),
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'title': 'Name Source',
      }),
      'template': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': 'Used for movies and episodes alike (it replaces both templates of the options).',
        'title': 'Template',
      }),
    }),
    'title': 'JobNaming',
    'type': 'object',
  })
