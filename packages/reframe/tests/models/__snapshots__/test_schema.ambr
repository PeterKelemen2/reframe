# name: test_json_schema_snapshot[ToolInfo]
  dict({
    '$defs': list([
      'AddOp',
      'CopyOp',
      'Fix',
      'JsonValue',
      'MoveOp',
      'RemoveOp',
      'ReplaceOp',
      'TestOp',
      'ToolOrigin',
      'ToolStatus',
    ]),
    'additionalProperties': False,
    'description': '''
      The result of discovering one tool.
      
      When ``origin`` is ``env`` or ``settings`` and the status is not ``found``, Reframe does
      **not** fall back to the bundled build: ``reason`` says why, and ``fixes`` offers
      "Use bundled" (a patch on ``AppSettings`` that removes the Settings path). An environment
      override cannot be changed in the app, so it has no fix, and the reason says so.
    ''',
    'properties': dict({
      'build_flags': dict({
        'description': '''
          FFmpeg: the arguments of the ``configuration:`` line (``--enable-libx265`` …), for
          diagnostics.
        ''',
        'items': dict({
          'type': 'string',
        }),
        'title': 'Build Flags',
        'type': 'array',
      }),
      'env': dict({
        'additionalProperties': dict({
          'type': 'string',
        }),
        'description': '''
          Extra environment variables to set when running this tool (for example
          ``LIBVA_DRIVERS_PATH`` for the bundled FFmpeg on Linux). Pass as ``extra_env`` to
          :func:`reframe.tools.run`.
        ''',
        'title': 'Env',
        'type': 'object',
      }),
      'env_var': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': 'The environment variable that overrides this tool (``REFRAME_FFMPEG``).',
        'title': 'Env Var',
      }),
      'fixes': dict({
        'items': dict({
          '$ref': '#/$defs/Fix',
        }),
        'title': 'Fixes',
        'type': 'array',
      }),
      'library_versions': dict({
        'additionalProperties': dict({
          'type': 'string',
        }),
        'description': 'FFmpeg: ``{"libavcodec": "63.1.102", …}``.',
        'title': 'Library Versions',
        'type': 'object',
      }),
      'name': dict({
        'enum': list([
          'ffmpeg',
          'ffprobe',
          'mkvpropedit',
          'mediainfo',
        ]),
        'title': 'Name',
        'type': 'string',
      }),
      'next_to_ffmpeg': dict({
        'default': False,
        'description': "ffprobe only: it was found next to an overridden ffmpeg (its ``origin`` is the ffmpeg's).",
        'title': 'Next To Ffmpeg',
        'type': 'boolean',
      }),
      'origin': dict({
        'anyOf': list([
          dict({
            '$ref': '#/$defs/ToolOrigin',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': '``None`` when nothing was found.',
      }),
      'path': dict({
        'anyOf': list([
          dict({
            'format': 'path',
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': 'The binary that is (or would be) run. Set for a missing override too (the bad path).',
        'title': 'Path',
      }),
      'reason': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': '''
          Why the status is not ``found``; for ``found`` an optional note (for example "version
          could not be read").
        ''',
        'title': 'Reason',
      }),
      'release': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': 'The upstream release, ``9.0.2``; ``None`` for git master builds.',
        'title': 'Release',
      }),
      'release_series': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': '''
          ``9.0`` for a release; for a git master build the series of its library versions
          (``9.0`` for ``libavcodec 63``), used for the minimum-version check.
        ''',
        'title': 'Release Series',
      }),
      'status': dict({
        '$ref': '#/$defs/ToolStatus',
      }),
      'version': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': '''
          The version string as the tool prints it: ``n9.0.2-17-g2a571b6068-20260930``,
          ``N-127032-g6ae491a26c-20260930``, ``101.0``.
        ''',
        'title': 'Version',
      }),
    }),
    'required': list([
      'name',
      'status',
    ]),
    'title': 'ToolInfo',
    'type': 'object',
  })
