  dict({
    '$defs': list([
      'Rational',
    ]),
    'additionalProperties': False,
    'description': 'What C-5 needs to know about the source picture.',
    'properties': dict({
      'chroma_assumed': dict({
        'default': False,
        'description': '''
          ``True`` when the pixel format is unknown and the chroma steps are C-5's assumption
          (4:2:0, steps of 2).
        ''',
        'title': 'Chroma Assumed',
        'type': 'boolean',
      }),
      'chroma_step_x': dict({
        'default': 2,
        'description': 'Horizontal crop step for the chroma grid (2 for 4:2:0 and 4:2:2, 1 for 4:4:4).',
        'minimum': 1,
        'title': 'Chroma Step X',
        'type': 'integer',
      }),
      'chroma_step_y': dict({
        'default': 2,
        'description': '''
          Vertical crop step (2 for 4:2:0, 1 for 4:2:2 and 4:4:4; C-5 doubles it for interlaced
          sources, decision 0009).
        ''',
        'minimum': 1,
        'title': 'Chroma Step Y',
        'type': 'integer',
      }),
      'height': dict({
        'minimum': 1,
        'title': 'Height',
        'type': 'integer',
      }),
      'interlaced': dict({
        'default': False,
        'title': 'Interlaced',
        'type': 'boolean',
      }),
      'rotation': dict({
        'default': 0,
        'description': "Rotation from the source's display matrix (added to the job's ``rotate``).",
