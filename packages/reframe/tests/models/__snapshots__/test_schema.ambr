    'properties': dict({
      'kind': dict({
        'default': 'changed',
        'description': '''
          ``added``: only the edited settings have the field (or list item); ``removed``: only
          the preset has it.
        ''',
        'enum': list([
          'changed',
          'added',
          'removed',
        ]),
        'title': 'Kind',
        'type': 'string',
      }),
      'path': dict({
        'description': '''
          Dotted field path, as in ``ValidationIssue.path``: ``video.encoder``,
          ``audio_defaults.codec_rules[0].max_bitrate``.
        ''',
        'title': 'Path',
        'type': 'string',
      }),
      'preset_value': dict({
        '$ref': '#/$defs/JsonValue',
        'default': None,
        'description': "The preset's value (``None`` for ``added``).",
      }),
      'value': dict({
        '$ref': '#/$defs/JsonValue',
        'default': None,
        'description': 'The edited value (``None`` for ``removed``).',
      }),
    }),
    'required': list([
      'path',
    ]),
    'title': 'FieldChange',
    'type': 'object',
  })
