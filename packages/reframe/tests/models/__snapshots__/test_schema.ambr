          'none',
        ]),
        'title': 'No Match',
        'type': 'string',
      }),
      'order': dict({
        'default': 'language_list',
        'enum': list([
          'language_list',
          'source',
        ]),
        'title': 'Order',
        'type': 'string',
      }),
      'other_languages': dict({
        'default': 'drop',
        'enum': list([
          'drop',
          'keep_first',
          'keep_all',
        ]),
        'title': 'Other Languages',
        'type': 'string',
      }),
      'tie_break': dict({
        'default': 'best_quality',
