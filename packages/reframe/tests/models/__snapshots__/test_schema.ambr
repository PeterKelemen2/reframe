# name: test_json_schema_snapshot[TrackDecision]
  dict({
    '$defs': list([
      'AudioOutputTrack',
      'ExternalSubtitle',
      'SubtitleOutputTrack',
      'TrackFlags',
      'TrackMetadata',
    ]),
    'additionalProperties': False,
    'description': '''
      What the audio or subtitle defaults did with one source track, and why: one row of the
      live preview.
      
      The selection stage fills ``selected`` and ``selection``. For a selected audio track, the
      codec-rule stage fills ``rule``, ``outputs`` and ``reason``. A dropped track has no outputs,
      and ``reason`` repeats why it was dropped.
    ''',
    'properties': dict({
      'kind': dict({
        'default': 'audio',
        'enum': list([
          'audio',
          'subtitle',
        ]),
        'title': 'Kind',
        'type': 'string',
      }),
      'measure': dict({
        'default': False,
        'description': '''
          The source bit rate is unknown and decided the outcome: the preview offers
          **Measure** (a packet-size scan).
        ''',
        'title': 'Measure',
        'type': 'boolean',
      }),
      'notes': dict({
        'description': '''
          Details that do not change the outcome: a snapped bitrate or sample rate, a downmix
          forced by the encoder, the extra outputs.
        ''',
        'items': dict({
          'type': 'string',
        }),
        'title': 'Notes',
        'type': 'array',
      }),
      'outputs': dict({
        'description': '''
          Audio: the output track(s), the rule's output, then its extra outputs. Empty when the
          track was dropped or no rule matched.
        ''',
        'items': dict({
          '$ref': '#/$defs/AudioOutputTrack',
        }),
        'title': 'Outputs',
        'type': 'array',
      }),
      'reason': dict({
        'description': '''
          Why, in one line: ``AC-3, 5.1, 224 ≤ 320: passthru``,
          ``Lossless source → encode at the max``,
          ``Rule 2 needs 5.1 or more. Rule 3 matches, and the source fits``.
        ''',
        'title': 'Reason',
        'type': 'string',
      }),
      'rule': dict({
        'anyOf': list([
          dict({
            'minimum': 1,
            'type': 'integer',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': 'The codec rule that matched, 1-based; ``None`` when none matched.',
        'title': 'Rule',
      }),
      'selected': dict({
        'default': True,
        'description': 'Taken by the selection stage.',
        'title': 'Selected',
        'type': 'boolean',
      }),
      'selection': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': '''
          Why it was taken or dropped, in one line: ``Hungarian: first matching track (best
          quality)``, ``Commentary: dropped``, ``No listed language: the default-flagged track``.
          ``None`` when no selection stage ran.
        ''',
        'title': 'Selection',
      }),
      'source_stream': dict({
        'description': 'Absolute stream index of the source track.',
        'minimum': 0,
        'title': 'Source Stream',
        'type': 'integer',
      }),
      'subtitle_outputs': dict({
        'description': 'Subtitles: the output track of a selected subtitle track (copy or burn-in).',
        'items': dict({
          '$ref': '#/$defs/SubtitleOutputTrack',
        }),
        'title': 'Subtitle Outputs',
        'type': 'array',
      }),
    }),
    'required': list([
      'source_stream',
      'reason',
    ]),
    'title': 'TrackDecision',
    'type': 'object',
  })
# ---
