# name: test_json_schema_snapshot[FieldOrder]
  dict({
    '$defs': list([
    ]),
    'description': '''
      ffprobe ``field_order``: ``tt`` and ``tb`` are both top field first, ``bb`` and ``bt``
      bottom field first (FFmpeg writes ``tb`` for TFF H.264; see testdata/README.md).
    ''',
    'enum': list([
      'progressive',
      'tff',
      'bff',
      'unknown',
    ]),
    'title': 'FieldOrder',
    'type': 'string',
  })
# ---
# name: test_json_schema_snapshot[FilterConfig]
  dict({
    '$defs': list([
    ]),
    'description': '''
      One filter of 03 §Filters: a preset (``default``, ``light``, …), an optional tune, and
      a custom parameter string for the ``custom`` preset. A filter that is off is not in
      :class:`FilterSettings` at all.
    ''',
    'properties': dict({
      'custom': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'title': 'Custom',
      }),
      'implementation': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': '''
          The FFmpeg implementation (C-6 ``FilterImplementation.id``): ``nlmeans`` or
          ``hqdn3d`` for Denoise, ``bwdif`` or ``yadif`` for Deinterlace, ``unsharp`` or ``cas``
          for Sharpen, ``zscale`` or ``libplacebo`` for Colorspace and Tone mapping. ``None`` = the
          filter's default: the first implementation the FFmpeg build can run (HandBrake stores
          this choice separately too, for example ``PictureDenoiseFilter``).
        ''',
        'title': 'Implementation',
      }),
      'preset': dict({
        'default': 'default',
        'description': 'A preset of the chosen implementation (``FilterImplementation.presets`` in C-6).',
        'title': 'Preset',
        'type': 'string',
      }),
      'tune': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'title': 'Tune',
      }),
    }),
    'title': 'FilterConfig',
    'type': 'object',
  })
# ---
# name: test_json_schema_snapshot[FilterSettings]
  dict({
    '$defs': list([
      'FilterConfig',
    ]),
    'additionalProperties': dict({
      '$ref': '#/$defs/FilterConfig',
    }),
    'description': '''
      Ordered map ``filter_id → FilterConfig``.
      
      Filter ids are those of the definitions (C-6): ``detelecine``, ``interlace_detection``,
      ``deinterlace``, ``denoise``, ``chroma_smooth``, ``sharpen``, ``deblock``,
      ``colorspace``, ``tonemap``, ``grayscale``, ``custom``. The order in the graph is fixed
      by 03 §Filters; the map order matters only for display.
    ''',
    'title': 'FilterSettings',
    'type': 'object',
  })
