        'title': 'Position',
        'type': 'integer',
      }),
      'profile': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': 'The commercial name (``DTS-HD MA``, ``TrueHD Atmos``).',
        'title': 'Profile',
      }),
      'roles': dict({
        'items': dict({
          '$ref': '#/$defs/TrackRole',
        }),
        'title': 'Roles',
        'type': 'array',
      }),
      'title': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'title': 'Title',
      }),
    }),
    'required': list([
      'kind',
      'index',
      'position',
    ]),
    'title': 'TrackDescriptor',
    'type': 'object',
  })
