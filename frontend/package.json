{
  "name": "reframe-frontend",
  "version": "0.10.0",
  "private": true,
  "description": "Reframe web and desktop UI (Vue 3 + PrimeVue)",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev:web": "vite --mode web",
    "dev:desktop": "vite --mode desktop",
    "build:web": "vite build --mode web",
    "build:desktop": "vite build --mode desktop",
    "preview": "vite preview --mode web",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.e2e-page.json",
    "test": "vitest run --project unit",
    "test:server": "vitest run --project server",
    "test:watch": "vitest --project unit",
    "e2e": "playwright test",
    "gen:api": "bash ../scripts/gen-api.sh"
  },
  "dependencies": {
    "@lucide/vue": "^1.77.0",
    "@primeuix/themes": "^2.0.3",
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-notification": "2.8.1",
    "@tauri-apps/plugin-opener": "2.7.3",
    "@vueuse/core": "^15.0.0",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.1.0",
    "primevue": "^4.5.5",
    "rfc6902": "^5.5.0",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.23",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
