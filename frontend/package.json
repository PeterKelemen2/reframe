{
  "name": "reframe-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "Reframe web and desktop UI (Vue 3 + PrimeVue)",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev:web": "vite --mode web",
    "dev:desktop": "vite --mode desktop",
    "build:web": "vite build --mode web",
    "build:desktop": "vite build --mode desktop",
    "preview": "vite preview --mode web",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lucide/vue": "^1.58.0",
    "@primeuix/themes": "^2.0.3",
    "pinia": "^4.1.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "oxfmt": "0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
