              "chain": "nlmeans=s=4.2:p=7:pc=7:r=3:rc=3",
              "tune_chains": {
                "film": "nlmeans=s=4.2:p=7:pc=7:r=3:rc=3",
                "grain": "nlmeans=s=1:p=7:pc=7:r=3:rc=3",
                "highmotion": "nlmeans=s=4.2:p=7:pc=7:r=3:rc=5",
                "animation": "nlmeans=s=2.5:p=5:pc=5:r=7:rc=7",
                "tape": "nlmeans=s=1:p=3:pc=5:r=5:rc=5",
                "sprite": "nlmeans=s=1.5:p=5:pc=5:r=5:rc=9"
              },
              "custom": false,
              "handbrake": "NLMeans medium: y-strength=6, cb-strength=6, patch 7/7, range 3/3"
            },
            {
              "id": "strong",
              "label": "Strong",
              "help": "",
              "chain": "nlmeans=s=7:p=7:pc=7:r=3:rc=3",
              "tune_chains": {
                "film": "nlmeans=s=5.6:p=7:pc=7:r=3:rc=3",
                "grain": "nlmeans=s=1:p=7:pc=7:r=3:rc=3",
                "highmotion": "nlmeans=s=5.6:p=7:pc=7:r=3:rc=5",
                "animation": "nlmeans=s=5:p=5:pc=5:r=7:rc=7",
                "tape": "nlmeans=s=1.75:p=5:pc=5:r=5:rc=5",
                "sprite": "nlmeans=s=1.5:p=5:pc=5:r=7:rc=11"
