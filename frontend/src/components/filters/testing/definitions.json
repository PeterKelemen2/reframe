          "combed_only": null,
          "needs_vulkan": false,
          "presets": [
            {
              "id": "ultralight",
              "label": "Ultralight",
              "help": "",
              "chain": "nlmeans=s=1.05:p=7:pc=7:r=3:rc=3",
              "tune_chains": {
                "film": "nlmeans=s=1.05:p=7:pc=7:r=3:rc=3",
                "grain": "nlmeans=s=1:p=7:pc=7:r=3:rc=3",
                "highmotion": "nlmeans=s=1.05:p=7:pc=7:r=3:rc=5",
