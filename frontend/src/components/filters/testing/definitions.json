              "custom": false,
              "handbrake": "NLMeans strong: y-strength=10, cb-strength=10, patch 7/7, range 3/3"
            },
            {
              "id": "custom",
              "label": "Custom",
              "help": "",
              "chain": "nlmeans={custom}",
              "tune_chains": {},
              "custom": true,
              "handbrake": null
            }
          ],
          "tunes": [
            {
              "id": "film",
              "label": "Film",
              "help": "Most content, live action."
            },
            {
              "id": "grain",
              "label": "Grain",
              "help": "Keeps luma grain; FFmpeg's nlmeans cannot leave luma alone, so it denoises very lightly."
            },
            {
              "id": "highmotion",
              "label": "High motion",
              "help": "Avoids colour smearing in fast motion."
            },
            {
              "id": "animation",
              "label": "Animation",
              "help": "Cel animation: cartoons, anime."
            },
            {
              "id": "tape",
              "label": "Tape",
              "help": "Analogue tape: VHS."
            },
            {
              "id": "sprite",
              "label": "Sprite",
              "help": "1- to 16-bit 2D games."
            }
          ],
          "default_preset": "light"
        },
        {
          "id": "hqdn3d",
          "label": "HQDN3D",
          "filters": ["hqdn3d"],
