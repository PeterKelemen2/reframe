              "handbrake": "HQDN3D ultralight: y-spatial=1, cb/cr-spatial=0.7, y-temporal=1, cb/cr-temporal=2"
            },
            {
              "id": "light",
              "label": "Light",
              "help": "",
              "chain": "hqdn3d=luma_spatial=2:chroma_spatial=1:luma_tmp=2:chroma_tmp=3",
              "tune_chains": {},
              "custom": false,
              "handbrake": "HQDN3D light: y-spatial=2, cb/cr-spatial=1, y-temporal=2, cb/cr-temporal=3"
            },
            {
              "id": "medium",
              "label": "Medium",
              "help": "",
              "chain": "hqdn3d=luma_spatial=3:chroma_spatial=2:luma_tmp=2:chroma_tmp=3",
              "tune_chains": {},
              "custom": false,
              "handbrake": "HQDN3D medium: y-spatial=3, cb/cr-spatial=2, y-temporal=2, cb/cr-temporal=3"
            },
            {
              "id": "strong",
              "label": "Strong",
              "help": "",
              "chain": "hqdn3d=luma_spatial=7:chroma_spatial=7:luma_tmp=5:chroma_tmp=5",
              "tune_chains": {},
              "custom": false,
              "handbrake": "HQDN3D strong: y-spatial=7, cb/cr-spatial=7, y-temporal=5, cb/cr-temporal=5"
            },
            {
              "id": "custom",
              "label": "Custom",
              "help": "",
              "chain": "hqdn3d={custom}",
              "tune_chains": {},
              "custom": true,
              "handbrake": null
            }
          ],
          "tunes": [],
          "default_preset": "light"
        }
      ],
      "help": {
        "what": "Removes noise and grain. A cleaner picture compresses much better.",
        "use_when": "Noisy sources: old films, low-light video, VHS, DVD with visible noise.",
        "avoid_when": "Clean sources, or grain you want to keep (use the encoder's grain tune or SVT-AV1 film grain instead).",
        "speed_cost": "high",
        "settings": "NLMeans (the default): Ultralight to Strong (HandBrake's presets); tunes adapt it to the content. HQDN3D: the same strengths, much faster, can smear at high strength. Custom: your nlmeans or hqdn3d parameters."
      }
    },
