{
  "filters": {
    "detelecine": {
      "id": "detelecine",
      "label": "Detelecine",
      "position": 0,
      "analysis": false,
      "implementations": [
        {
          "id": "fieldmatch",
          "label": "Field match",
          "filters": ["fieldmatch", "decimate"],
          "note": "",
          "requires_tagged_input": false,
          "combed_only": null,
          "needs_vulkan": false,
          "presets": [
            {
              "id": "default",
              "label": "Default",
              "help": "",
              "chain": "fieldmatch,decimate",
              "tune_chains": {},
              "custom": false,
              "handbrake": "skip-top=4:skip-bottom=4:skip-left=1:skip-right=1:plane=0 (pullup; no fieldmatch equivalent)"
            },
            {
              "id": "custom",
              "label": "Custom",
              "help": "",
              "chain": "fieldmatch={custom},decimate",
              "tune_chains": {},
              "custom": true,
              "handbrake": null
            }
          ],
          "tunes": [],
          "default_preset": "default"
        }
      ],
      "help": {
        "what": "Undoes 3:2 pulldown: rebuilds the original 24 fps film frames from 29.97 fps telecined video and drops the duplicates.",
        "use_when": "NTSC DVDs and broadcasts of film or TV series that show combing in a regular 3-of-5 frame pattern.",
        "avoid_when": "The source is already progressive, true interlaced video (sports, news), or PAL.",
        "speed_cost": "low",
        "settings": "Default: field matching with FFmpeg's defaults, then one frame in five dropped. Custom: your fieldmatch parameters."
      }
    },
    "interlace_detection": {
      "id": "interlace_detection",
      "label": "Interlace detection",
      "position": 1,
      "analysis": true,
      "implementations": [
        {
          "id": "idet",
          "label": "idet",
          "filters": ["idet"],
          "note": "",
          "requires_tagged_input": false,
          "combed_only": null,
          "needs_vulkan": false,
          "presets": [
            {
              "id": "default",
              "label": "Default",
              "help": "",
              "chain": "idet",
              "tune_chains": {},
              "custom": false,
              "handbrake": "mode=3:spatial-metric=2:motion-thresh=1:spatial-thresh=1:filter-mode=2:block-thresh=40:block-width=16:block-height=16"
            },
            {
              "id": "permissive",
              "label": "Less sensitive",
              "help": "",
              "chain": "idet=intl_thres=1.5",
              "tune_chains": {},
              "custom": false,
              "handbrake": "mode=3:spatial-metric=2:motion-thresh=3:spatial-thresh=3:filter-mode=2:block-thresh=40:block-width=16:block-height=16"
            },
            {
              "id": "fast",
              "label": "Fast",
              "help": "",
              "chain": "idet",
              "tune_chains": {},
              "custom": false,
              "handbrake": "mode=0:spatial-metric=2:motion-thresh=2:spatial-thresh=3:filter-mode=1:block-thresh=80:block-width=16:block-height=16"
            },
            {
              "id": "custom",
              "label": "Custom",
              "help": "",
              "chain": "idet={custom}",
              "tune_chains": {},
              "custom": true,
              "handbrake": null
            }
          ],
          "tunes": [],
          "default_preset": "default"
        }
      ],
      "help": {
        "what": "Finds interlaced frames, so that Deinterlace processes only those and leaves progressive frames untouched.",
        "use_when": "Mixed sources: progressive video with some interlaced parts (DVD extras, broadcasts).",
        "avoid_when": "The whole source is interlaced (deinterlace everything instead) or fully progressive.",
        "speed_cost": "low",
        "settings": "Default: FFmpeg's idet thresholds. Less sensitive: fewer frames count as interlaced. Fast: the same as Default (idet has no faster mode). Custom: your idet parameters."
      }
    },
    "deinterlace": {
      "id": "deinterlace",
      "label": "Deinterlace",
      "position": 2,
      "analysis": false,
      "implementations": [
        {
          "id": "bwdif",
          "label": "Bwdif",
          "filters": ["bwdif"],
          "note": "Bob Weaver: sharper than yadif, the default.",
          "requires_tagged_input": false,
          "combed_only": "deint=interlaced",
          "needs_vulkan": false,
          "presets": [
            {
              "id": "default",
              "label": "Default",
              "help": "",
              "chain": "bwdif=mode=send_frame:parity=auto",
              "tune_chains": {},
              "custom": false,
              "handbrake": "bwdif mode=3 (send_frame)"
            },
            {
              "id": "bob",
              "label": "Bob",
              "help": "",
              "chain": "bwdif=mode=send_field:parity=auto",
              "tune_chains": {},
              "custom": false,
              "handbrake": "bwdif mode=7 (send_field)"
            },
            {
              "id": "custom",
              "label": "Custom",
              "help": "",
              "chain": "bwdif={custom}",
              "tune_chains": {},
              "custom": true,
              "handbrake": null
            }
          ],
          "tunes": [],
          "default_preset": "default"
        },
        {
          "id": "yadif",
          "label": "Yadif",
          "filters": ["yadif"],
          "note": "Yet Another Deinterlacing Filter: HandBrake's classic.",
          "requires_tagged_input": false,
          "combed_only": "deint=interlaced",
          "needs_vulkan": false,
          "presets": [
            {
              "id": "default",
              "label": "Default",
              "help": "",
              "chain": "yadif=mode=send_frame:parity=auto",
              "tune_chains": {},
              "custom": false,
              "handbrake": "yadif mode=3 (send_frame)"
            },
            {
              "id": "skip-spatial",
              "label": "Skip spatial check",
              "help": "",
              "chain": "yadif=mode=send_frame_nospatial:parity=auto",
              "tune_chains": {},
              "custom": false,
              "handbrake": "yadif mode=1 (send_frame_nospatial)"
            },
            {
              "id": "bob",
              "label": "Bob",
              "help": "",
              "chain": "yadif=mode=send_field:parity=auto",
              "tune_chains": {},
              "custom": false,
              "handbrake": "yadif mode=7 (send_field)"
            },
            {
              "id": "custom",
              "label": "Custom",
              "help": "",
              "chain": "yadif={custom}",
              "tune_chains": {},
              "custom": true,
              "handbrake": null
            }
          ],
          "tunes": [],
          "default_preset": "default"
        }
      ],
      "help": {
        "what": "Turns interlaced video (two half-pictures per frame) into progressive frames, removing the comb artefacts.",
        "use_when": "DVDs and broadcasts that show combing on motion. With Interlace detection on, only the detected frames are processed.",
        "avoid_when": "Progressive sources: deinterlacing them only softens the picture.",
        "speed_cost": "low",
        "settings": "Bwdif (the default) or Yadif. Default: one output frame per frame. Bob: one frame per field, double frame rate, smoother motion. Skip spatial check (Yadif): faster. Custom: your bwdif / yadif parameters."
      }
    },
    "denoise": {
      "id": "denoise",
      "label": "Denoise",
      "position": 3,
      "analysis": false,
      "implementations": [
        {
          "id": "nlmeans",
