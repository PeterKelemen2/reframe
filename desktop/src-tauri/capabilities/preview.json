{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "preview",
  "description": "The detached preview window: the shell's events, and the preview clip in an external player.",
  "windows": ["preview"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://127.0.0.1:*/api/preview/clips/*" }]
    }
  ]
}
