{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: the shell's commands and events, native dialogs, drag-and-drop, notifications, reveal in the file manager, the preview clip in an external player, and whether the window can play it.",
  "windows": ["main"],
  "permissions": [
    "allow-backend-info",
    "allow-backend-retry",
    "allow-quit-ready",
    "allow-quit-app",
    "allow-hide-main-window",
    "allow-take-open-paths",
    "allow-set-taskbar-progress",
    "allow-open-preview-window",
    "allow-desktop-settings",
    "allow-set-desktop-settings",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "dialog:allow-message",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "opener:allow-reveal-item-in-dir",
    "allow-open-external",
    "allow-webview-plays-video"
  ]
}
