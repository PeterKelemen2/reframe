{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reframe",
  "mainBinaryName": "reframe-desktop",
  "version": "0.9.0",
  "identifier": "org.reframe.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm --prefix ../frontend run dev:desktop",
    "beforeBuildCommand": "npm --prefix ../frontend run build:desktop",
    "frontendDist": "../../frontend/dist-desktop"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": { "resources/sidecar/": "sidecar/", "resources/tools/": "tools/", "resources/notices/": "notices/" },
    "fileAssociations": [
      { "ext": ["mkv"], "mimeType": "video/x-matroska", "name": "Reframe.mkv", "description": "Matroska video" },
      { "ext": ["mp4"], "mimeType": "video/mp4", "name": "Reframe.mp4", "description": "MPEG-4 video" },
      { "ext": ["m2ts", "ts"], "mimeType": "video/mp2t", "name": "Reframe.m2ts", "description": "MPEG transport stream" },
      { "ext": ["avi"], "mimeType": "video/x-msvideo", "name": "Reframe.avi", "description": "AVI video" },
      { "ext": ["mov"], "mimeType": "video/quicktime", "name": "Reframe.mov", "description": "QuickTime video" },
      { "ext": ["webm"], "mimeType": "video/webm", "name": "Reframe.webm", "description": "WebM video" }
    ],
    "linux": {
      "deb": {
        "depends": ["ca-certificates"],
        "postInstallScript": "linux/link-cli.sh",
        "preRemoveScript": "linux/unlink-cli.sh"
      },
      "rpm": {
        "depends": ["ca-certificates"],
        "postInstallScript": "linux/link-cli.sh",
        "preRemoveScript": "linux/unlink-cli.sh"
      }
    },
    "windows": {
      "nsis": { "installerHooks": "windows/hooks.nsh" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyMjEyQjUxMTk3OTFBOEYKUldTUEdua1pVU3NoOGh4VnAzM2tmTG1QaUtTL3FQNkpzY3FyZEtJOE5QVVRtS0lwZjRrbjRHQlMK",
      "endpoints": ["https://github.com/PeterKelemen2/reframe/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
