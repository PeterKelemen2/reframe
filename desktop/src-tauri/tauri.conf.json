{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reframe",
  "mainBinaryName": "reframe-desktop",
  "version": "0.1.0",
  "identifier": "org.reframe.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm --prefix ../frontend run dev:desktop",
    "beforeBuildCommand": "npm --prefix ../frontend run build:desktop",
    "frontendDist": "../../frontend/dist-desktop"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
